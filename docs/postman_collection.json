            "value": "Bearer {{admin_token}}"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"action\": \"logout\",\n  \"data\": {}\n}"
        },
        "url": "{{base_url}}/api"
      },
      "event": [
        {
          "listen": "test",
          "script": {
