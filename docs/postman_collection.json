        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"action\": \"login\",\n  \"data\": {\n    \"username\": \"{{admin_username}}\",\n    \"password\": \"{{admin_password}}\"\n  }\n}"
        },
        "url": "{{base_url}}/api"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP成功\", function () { pm.response.to.have.status(200); });",
              "pm.test(\"业务成功\", function () { pm.expect(pm.response.json().ok).to.eql(true); });",
              "if (pm.response.json().ok) pm.collectionVariables.set(\"admin_token\", pm.response.json().data.token);"
            ]
          }
        }
      ]
    },
